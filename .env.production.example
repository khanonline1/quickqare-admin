# ── Netlify / Production Environment Variables ────────────────────────────────
# Set these in: Netlify Dashboard → Site → Site configuration → Environment variables
# DO NOT commit a real .env file — Netlify reads these from its dashboard at build time.
#
# The value below must point to your backend server (VPS IP or custom domain).
# Example with IP:     http://168.144.64.189:4000/api/v1/admin
# Example with domain: https://api.quickqare.com/api/v1/admin
# ─────────────────────────────────────────────────────────────────────────────
VITE_ADMIN_API_BASE_URL=https://api.quickqare.com/api/v1/admin
