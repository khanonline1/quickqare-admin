# Example nginx config for serving the QuickQare admin panel.
#
# For production you should terminate TLS here (listen 443 ssl) and redirect
# port 80 -> 443 so the Strict-Transport-Security header below is meaningful.
# The `listen 80` block is kept for local/example use only.

server {
    listen 80;
    server_name admin.yourdomain.com;

    root /var/www/quickqare-admin/dist;
    index index.html;

    # --- Security headers (mirror netlify.toml) ---
    # `always` so the headers are sent on error responses too.
    # Keep the CSP in sync with netlify.toml: the script-src hash is the sha256
    # of the inline theme-bootstrap script in index.html — recompute it if that
    # script changes, or the theme bootstrap will be blocked.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-153tklE6SR6g2+xK7e6eNHp8eUBaI/IVVnh9fL/KvG0='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.quickqare.in wss://api.quickqare.in" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
